# Git files
.git
.gitignore
.gitattributes

# Python cache
__pycache__
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv
.venv_ci/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
tests/
*.test

# Documentation
docs/
*.md
!README.md
LICENSE

# Local data (will be mounted as volumes)
chroma_db/
.preferences/
.notifications/
.sessions/
dataset/

# Environment files (sensitive)
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.swp

# OS files
Thumbs.db
.DS_Store

# Development scripts
run_tests.sh
test_*.sh
*.ps1

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Other
*.sqlite
*.db
node_modules/

# Private non-committed materials (exclude from images)
private/

# Trae + IDE history (exclude from images)
.history/
.trae/

# Frontend is built in its own image (not needed in backend context)
frontend/
apps/web/
.next/
next-env.d.ts

# Local artifacts
artifacts/

# Deploy directory (not needed in backend image)
deploy/

# Apps directories except api
apps/database/

# Additional exclusions
# Note: apps/api/data/ contains Python source code, must be included
data/
!apps/api/data/
**/audit/*.csv
uv.lock
coverage.xml
tmp/
dummy/

# Exclude node_modules except for frontend build
node_modules/
!apps/web/node_modules/

# Keep root package.json but allow apps/web/package.json
package.json
!apps/web/package.json
package-lock.json
!apps/web/package-lock.json
