# AI Real Estate Assistant - Backend Environment Variables
# Copy this file to .env and fill in your values
# Generate secrets: openssl rand -hex 32

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# LLM PROVIDER API KEYS (at least one required)
# =============================================================================
# Single key per provider (legacy format)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
XAI_API_KEY=...
DEEPSEEK_API_KEY=...
ZHIPUAI_API_KEY=...
MOONSHOT_API_KEY=...

# The remaining providers the product registers. They used to be missing
# from this file, so a self-hoster read a list of seventeen providers in the
# README and could not configure nine of them without reading settings.py.
OPENROUTER_API_KEY=sk-or-...
MINIMAX_API_KEY=...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
DASHSCOPE_API_KEY=...
OPENCODE_API_KEY=...
TOGETHER_API_KEY=...
FIREWORKS_API_KEY=...
HUGGINGFACE_API_KEY=hf_...

# The MiniMax endpoint and the model it answers with. The key above may also
# be set as REALT_MINIMAX_API_KEY, which wins over the workstation-wide
# MINIMAX_API_KEY - so a developer's own account cannot shadow the
# deployment's key.
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_DEFAULT_MODEL=MiniMax-M3.1-Flash

# Multi-key per provider (for failover) - CSV format
# Uncomment to enable automatic key rotation when one hits rate limits
# OPENAI_API_KEYS=sk-key1,sk-key2,sk-key3
# ANTHROPIC_API_KEYS=sk-ant-key1,sk-ant-key2
# GOOGLE_API_KEYS=key1,key2

# Default LLM provider. The seventeen registered ones:
# openai, anthropic, google, grok, deepseek, openrouter, groq, mistral, qwen,
# zai, moonshot, opencode, together, fireworks, huggingface, ollama, minimax.
# The model belongs to the provider - DEFAULT_MODEL overrides it, and leaving
# it unset takes the provider's own default. A model id from another provider
# is a 404, not a fallback.
DEFAULT_PROVIDER=openai

# =============================================================================
# MULTI-PROVIDER FAILOVER (optional)
# =============================================================================
# Enable multi-key and multi-provider failover
# ENABLE_MULTI_KEY_FALLBACK=true

# Key rotation strategy: round-robin, random, priority
# KEY_ROTATION_STRATEGY=round-robin

# Number of failures before switching to next key
# KEY_FAILURE_THRESHOLD=5

# Provider fallback order (comma-separated)
# PROVIDER_PRIORITY_ORDER=openai,anthropic,google,deepseek,zai

# Ollama (local LLM - optional)
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=llama3.2:3b

# =============================================================================
# API SECURITY (REQUIRED)
# =============================================================================
# Generate: openssl rand -hex 32
API_ACCESS_KEY=your-generated-api-key-here

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Local: * or http://localhost:3800
# Production: REQUIRED - explicit list, no wildcards
CORS_ALLOW_ORIGINS=http://localhost:3800

# =============================================================================
# JWT AUTHENTICATION (optional)
# =============================================================================
# AUTH_JWT_ENABLED=true
# JWT_SECRET_KEY=your-jwt-secret-key-here
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (local dev): sqlite+aiosqlite:///./data/auth.db
# PostgreSQL (production): postgresql+asyncpg://user:password@localhost:5432/realestate
DATABASE_URL=sqlite+aiosqlite:///./data/auth.db

# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# =============================================================================
# REDIS (optional - for caching)
# =============================================================================
# REDIS_URL=redis://localhost:6379

# =============================================================================
# SENTRY (optional - error tracking & APM, Task #56)
# =============================================================================
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_ENVIRONMENT=production
# =============================================================================
# OAUTH (optional)
# =============================================================================
# The Google button appears only when the flag, the credentials, the redirect
# URI and JWT itself are all configured - a button that cannot work is not
# shown.
# AUTH_OAUTH_GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx
# GOOGLE_REDIRECT_URI=http://localhost:3800/api/v1/auth/oauth/callback

# Apple Sign-In. It reads its private key from a file and reuses the same
# redirect URI setting as Google.
# AUTH_OAUTH_APPLE_ENABLED=false
# APPLE_CLIENT_ID=xxx.com.service
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_PRIVATE_KEY_PATH=/run/secrets/AppleAuthKey.p8

# The address the interface is served on. It builds the links in the
# verification and password-reset e-mails.
# FRONTEND_URL=http://localhost:3800

# =============================================================================
# EMAIL (optional)
# =============================================================================
# EMAIL_PROVIDER=console
# EMAIL_FROM_ADDRESS=noreply@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your.email@gmail.com
# SMTP_PASSWORD=your-app-specific-password

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# AUTH_REGISTRATION_ENABLED=true
# AUTH_EMAIL_VERIFICATION_REQUIRED=true
# AUTH_LOCKOUT_MAX_ATTEMPTS=5
# AUTH_LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# DEMO MODE (for public staging / showcase)
# =============================================================================
# DEMO_MODE=true

# The four halves of the demo mode. Each one follows DEMO_MODE unless it is
# set on its own.
# DEMO_DATA_MODE=true          # seed the demo catalogue
# DEMO_LLM_MODE=true           # answer with the canned model, no provider call
# DEMO_API_KEY_BYPASS=true     # accept the demo API key on the public routes
# DEMO_USER_BYPASS=true        # answer an anonymous request with a shared user

# The password of the seeded demo accounts (demo.admin1@realestate.demo and
# the other forty-nine). It is the deployment's own: set it in the
# environment, never in the repository. Without it the seeded accounts carry
# no password and cannot be signed into.
# DEMO_USER_PASSWORD=

# =============================================================================
# RATE LIMITING
# =============================================================================
# API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_RPM=600

# A second and a third API key, for a rotation. CSV format.
# API_ACCESS_KEYS=key-two,key-three

# =============================================================================
# WEB SEARCH (optional - the assistant answers with live sources)
# =============================================================================
# Without this the assistant answers from the catalogue alone and says so.
# INTERNET_ENABLED=true
# SEARXNG_URL=http://searxng:8080

# =============================================================================
# COMMUTE TIMES (optional - Google Routes)
# =============================================================================
# GOOGLE_ROUTES_ENABLED=true
# GOOGLE_ROUTES_API_KEY=...

# =============================================================================
# METRICS (optional - Prometheus)
# =============================================================================
# METRICS_ENABLED=true
# METRICS_PATH=/metrics
# PROMETHEUS_ENABLED=true

# =============================================================================
# FREE TIER (optional - the anonymous chat quota)
# =============================================================================
# FREE_TIER_ENABLED=true
# FREE_TIER_HOURLY_LIMIT=10
# FREE_TIER_DAILY_LIMIT=50
# FREE_TIER_DEFAULT_MODEL=...
# FREE_TIER_PROVIDER_CASCADE=["openai","ollama"]

# =============================================================================
# PUSH NOTIFICATIONS (optional - Web Push)
# =============================================================================
# PUSH_ENABLED=true
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:admin@example.com

# =============================================================================
# MCP SERVER (optional - the Model Context Protocol surface)
# =============================================================================
# MCP_ENABLED=true
# MCP_EDITION=oss
# MCP_ALLOWLIST=["search_properties"]
